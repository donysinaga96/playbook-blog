# Salin ke .env lalu ganti password. File .env tidak boleh masuk Git.

# --- PostgreSQL (pemilik schema; dipakai migration & tooling) ---
POSTGRES_USER=blog
POSTGRES_PASSWORD=ganti_password_pemilik
POSTGRES_DB=blog_dev
POSTGRES_PORT=5432

# --- Role aplikasi (dipakai Nuxt; hanya baca/tulis data, tanpa DDL) ---
APP_DB_USER=blog_app
APP_DB_PASSWORD=ganti_password_aplikasi

# --- Role AI agent (ADR-010; agent di luar repo, lihat docs/kontrak-agent.md) ---
# Hanya boleh menulis generated_articles. Password kosong = role NOLOGIN.
AGENT_DB_USER=blog_agent
AGENT_DB_PASSWORD=

# --- Development ---
SEED_DEV_DATA=true
ADMINER_PORT=8080

# --- Dibaca aplikasi Nuxt yang berjalan di host ---
# Samakan user/password/port dengan nilai di atas.
DATABASE_URL=postgres://blog_app:ganti_password_aplikasi@localhost:5432/blog_dev

# --- Mode deploy (ADR-001), divalidasi saat server start ---
# multi : site dipilih dari Host request (site_domains); SITE_CODE dikosongkan
# single: satu site; isi SITE_CODE dengan sites.code, domain tetap dicek
SITE_MODE=multi
# SITE_CODE=kabar-tekno

# --- Media ---
# Folder file media di disk lokal: file dibaca dari dan diunggah ke
# MEDIA_DIR/<storage_key>. Kosong: upload admin ditolak (503); di dev media
# yang filenya tidak ada tampil sebagai placeholder, di produksi 404.
# Dev: pakai folder .data/media di repo (diabaikan Git), path absolut.
# MEDIA_DIR=/srv/blog/media
# Awalan URL media. Default /media (dilayani aplikasi). Ganti ke URL CDN bila perlu.
# MEDIA_BASE_URL=/media

# --- Cache publik ---
# s-maxage halaman publik, RSS, dan sitemap (detik, 0..3600; bawaan 60; 0 = no-store).
# Ini juga batas keterlambatan artikel terjadwal atau yang baru di-approve bila
# ada cache bersama (reverse proxy/CDN) di depan aplikasi.
# PUBLIC_CACHE_TTL=60

# --- Log ---
# Satu baris JSON per kejadian (request, peringatan, galat) ke stdout/stderr.
# text = satu baris yang mudah dibaca, untuk dev. Ringkasan per site:
#   pnpm --filter @framework/web log:report <file-log>
# LOG_FORMAT=text

# Admin (ADR-009). Tanpa ADMIN_SESSION_SECRET, admin nonaktif (semua path
# admin 404). Secret minimal 32 karakter, mis. hasil `openssl rand -base64 48`.
# Mode multi: admin hanya di ADMIN_HOST (dev: http://admin.localhost:3000/admin).
# Mode single: ADMIN_HOST dikosongkan; admin ada di domain site.
ADMIN_SESSION_SECRET=
ADMIN_HOST=admin.localhost
# Hanya untuk otomasi `pnpm admin:create` tanpa terminal (CI); di terminal password diketik.
# ADMIN_PASSWORD=
# true bila server di belakang SATU reverse proxy (M5); pembatas login lalu
# memakai entri paling kanan X-Forwarded-For (yang ditambahkan proxy itu).
# TRUST_PROXY=true
