{
  "name": "blog-framework",
  "private": true,
  "description": "Framework web artikel multi-site / multi-template",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @framework/web dev",
    "build": "pnpm --filter @framework/web build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && vue-tsc -p templates/tsconfig.json --noEmit && pnpm --filter @framework/web typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "docker compose run --rm db-migrate",
    "db:pull": "pnpm --filter @framework/db pull",
    "db:test": "docker compose --profile test run --rm db-test",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:psql": "docker compose exec db sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",
    "db:backup": "docker compose --profile tools run --rm db-backup",
    "db:restore": "docker compose --profile tools run --rm db-restore",
    "db:size": "docker compose exec -T db sh -c 'psql -X -q -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"' < packages/db/scripts/size.sql",
    "db:adminer": "docker compose --profile tools up -d adminer",
    "tutorial": "node docs/tutorial/build.mjs",
    "admin:create": "pnpm --filter @framework/web admin:create",
    "site:create": "pnpm --filter @framework/web site:create",
    "site:domain": "pnpm --filter @framework/web site:domain",
    "revenue:sync": "pnpm --filter @framework/web revenue:sync",
    "revenue:demo": "pnpm --filter @framework/web revenue:demo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "6.0.11",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.2",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  }
}
