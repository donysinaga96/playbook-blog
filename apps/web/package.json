{
  "name": "@framework/web",
  "version": "0.0.0",
  "private": true,
  "description": "Nuxt: public site + /admin + server/api",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --dotenv ../../.env --host localhost",
    "build": "nuxt build",
    "preview": "node --env-file-if-exists=../../.env .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "smoke": "node --env-file-if-exists=../../.env scripts/smoke-build.mjs",
    "gate": "node --env-file-if-exists=../../.env scripts/gate-parallel.mjs",
    "browser-check": "node scripts/browser-check.mjs",
    "admin:create": "node --env-file-if-exists=../../.env --import tsx scripts/admin-create.ts",
    "site:create": "node --env-file-if-exists=../../.env --import tsx scripts/site-create.ts",
    "site:domain": "node --env-file-if-exists=../../.env --import tsx scripts/site-domain.ts",
    "gate:admin": "node --env-file-if-exists=../../.env scripts/gate-admin.mjs",
    "log:report": "node scripts/log-report.mjs",
    "gate:content": "node --env-file-if-exists=../../.env --import tsx scripts/gate-content.ts",
    "demo:saksang": "node --env-file-if-exists=../../.env --import tsx scripts/demo-saksang.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@framework/core": "workspace:*",
    "@framework/db": "workspace:*",
    "@framework/template-base": "workspace:*",
    "@framework/template-kit": "workspace:*",
    "@framework/template-magazine": "workspace:*",
    "@framework/template-news": "workspace:*",
    "nuxt": "4.6.4",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "playwright": "1.49.1",
    "typescript": "~6.0.3",
    "vue-tsc": "^3.3.14"
  }
}
